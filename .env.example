# =============================================================================
# Single environment file for the whole monorepo — backend AND storefront.
#
#   cp .env.example .env
#
# Both apps read the root .env (apps/backend/medusa-config.ts and
# apps/storefront/next.config.js load it explicitly). There are no per-app
# .env files — do not create apps/backend/.env or apps/storefront/.env.local.
#
# PostgreSQL, Redis and nginx are EXTERNAL; compose.yaml runs the three apps.
# From inside a container `localhost` is the container itself, so any
# service on the Docker host must be addressed as `host.docker.internal`
# (compose.yaml maps that to the host gateway on Linux too).
#
# docker `env_file` does NOT expand ${VARS} — every value must be literal.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# Host ports published by compose.yaml (container ports are 8000/9000/8100).
# nginx on the host proxies the public domains to these.
#   7341 -> storefront (shop.travories.com)
#   7342 -> backend    (api.shop.travories.com AND admin.shop.travories.com)
#   7343 -> vendor dashboard
#
# One backend process serves both, routed by path: /store, /admin and /auth are
# the API, /app is the admin dashboard. The two domains are separate front doors
# onto the same port, so no third port is needed.
PORT_FE=7341
PORT_BE=7342
PORT_VENDOR=7343


# =============================================================================
# BACKEND (@dtc/backend — Medusa)
# =============================================================================

# --- External PostgreSQL -----------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- External Redis ----------------------------------------------------------
# Local non-Docker development URL.
REDIS_URL=redis://localhost:6383

# Compose overrides REDIS_URL with this Docker-reachable endpoint. If Redis
# runs on the Docker host, use host.docker.internal rather than localhost.
REDIS_DOCKER_URL=redis://host.docker.internal:6383

# --- Secrets (generate with: openssl rand -base64 32) ------------------------
JWT_SECRET=CHANGE_ME_openssl_rand_base64_32
COOKIE_SECRET=CHANGE_ME_openssl_rand_base64_32
AUTH_MFA_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# --- CORS --------------------------------------------------------------------
# STORE_CORS: every origin the storefront is served from.
# ADMIN_CORS / AUTH_CORS: the origins the admin dashboard is served from.
# medusa-config.ts pins admin.backendUrl to "/", so the dashboard calls the host
# it is served from and is same-origin either way — the admin entries below are
# a safety net, not a requirement.
STORE_CORS=https://shop.example.com,http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=https://shop.example.com,http://localhost:8000,http://localhost:9000

# Public URL of the backend, used by src/lib/store-media.ts to build absolute
# media URLs. It does NOT set the admin dashboard's API URL — medusa-config.ts
# pins admin.backendUrl to "/" so the dashboard stays same-origin on whichever
# domain serves it.
MEDUSA_BACKEND_URL=https://api.shop.example.com

# --- Object storage (S3-compatible / Garage) ---------------------------------
# The file module is only registered when fileUrl, endpoint, bucket, region,
# access key and secret all resolve (apps/backend/src/lib/media-env.ts).
# S3_FILE_URL is the PUBLIC base URL objects are served from — verify this
# matches how Garage exposes the bucket before relying on it.
S3_FILE_URL=
S3_ENDPOINT=
S3_BUCKET_NAME_PUBLIC=
S3_REGION=garage
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- eSewa ePay v2 checkout (EPAYTEST = sandbox) -----------------------------
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_STOREFRONT_BASE_URL=https://shop.example.com
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_SUCCESS_PATH=/api/payment-return/esewa
ESEWA_FAILURE_PATH=/api/payment-return/esewa
ESEWA_TAX_AMOUNT=0
ESEWA_PRODUCT_SERVICE_CHARGE=0
ESEWA_PRODUCT_DELIVERY_CHARGE=0

# Unused by the current hosted-checkout flow; kept for future app-SDK work.
ESEWA_CLIENT_ID=
ESEWA_CLIENT_SECRET=
ESEWA_INTENT_PRODUCT_CODE=INTENT
ESEWA_INTENT_CLIENT_SECRET=


# =============================================================================
# STOREFRONT (@dtc/storefront — Next.js)
#
# Every NEXT_PUBLIC_* value is baked into the bundle at BUILD time — changing
# one requires `docker compose up -d --build storefront`.
# =============================================================================

# Required. Admin -> Settings -> Publishable API Keys.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Used by the browser AND by server-side rendering, so it must be the PUBLIC
# backend URL — a localhost value here breaks every request from a real client.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.shop.example.com

# Public URL of the STOREFRONT (canonical/OG URLs, sitemap).
NEXT_PUBLIC_BASE_URL=https://shop.example.com

NEXT_PUBLIC_DEFAULT_REGION=np

# Hostname of the media host. next/image and the OG image renderer silently
# refuse remote URLs from hosts that are not listed here.
NEXT_PUBLIC_MEDIA_HOSTNAME=

NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud only — leave blank for self-hosting.
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

# --- SEO and social sharing (all optional) -----------------------------------
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_PINTEREST_SITE_VERIFICATION=

# Optional development/admin account created by the idempotent seed script.
# Never commit real credentials. Set these only in the private root .env.
SEED_ADMIN_EMAIL=admin@travories.com
SEED_ADMIN_PASSWORD=
