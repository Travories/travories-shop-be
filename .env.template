# =============================================================================
# Root .env for the VPS docker-compose stack (postgres + redis + backend + caddy)
# Copy this to `.env` ON THE VPS and fill in real values. Never commit `.env`.
#
#   cp .env.template .env && nano .env
#
# NOTE: docker `env_file` does NOT expand ${VARS}. Every value below must be a
# literal string — that's why DATABASE_URL repeats the postgres user/password.
# =============================================================================

# --- Postgres (used by the postgres service AND the backend) -----------------
POSTGRES_USER=medusa
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=medusa

# Backend connects to postgres over the compose network (host = service name).
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above, written out.
DATABASE_URL=postgresql://medusa:CHANGE_ME_strong_db_password@postgres:5432/medusa

# --- Redis (compose network host = service name) -----------------------------
REDIS_URL=redis://redis:6379

# --- Secrets (generate with: openssl rand -base64 32) ------------------------
JWT_SECRET=CHANGE_ME_long_random_string
COOKIE_SECRET=CHANGE_ME_long_random_string

# --- CORS --------------------------------------------------------------------
# STORE_CORS: every origin the STOREFRONT is served from (Vercel URL + custom domain).
# ADMIN_CORS / AUTH_CORS: the backend's own https domain (admin dashboard lives there).
STORE_CORS=https://your-store.vercel.app,https://www.yourstore.com
ADMIN_CORS=https://api.yourdomain.com
AUTH_CORS=https://api.yourdomain.com

# --- Object storage (optional) -----------------------------------------------
# Leave blank to keep Medusa's local-file provider. Fill all S3_* to enable S3.
S3_FILE_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_BUCKET_NAME_PUBLIC=
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_SECRET_KEY=

# --- eSewa payment (optional; EPAYTEST is the sandbox) -----------------------
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_STOREFRONT_BASE_URL=https://your-store.vercel.app
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_SUCCESS_PATH=/api/payment-return/esewa
ESEWA_FAILURE_PATH=/api/payment-return/esewa
ESEWA_TAX_AMOUNT=0
ESEWA_PRODUCT_SERVICE_CHARGE=0
ESEWA_PRODUCT_DELIVERY_CHARGE=0
